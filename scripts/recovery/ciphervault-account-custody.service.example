[Unit]
Description=CipherVault account backup, custody copy and isolated restore
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ciphervault
Group=ciphervault
UMask=0077
WorkingDirectory=/var/lib/ciphervault-custody
ExecStart=/usr/bin/python3 /opt/ciphervault/scripts/recovery/account_custody.py --config /etc/ciphervault/custody.json --upload-only
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/ciphervault-account /run/secrets /etc/ciphervault
# Provision a dedicated gcloud configuration directory for this service's
# short-lived credentials; do not reuse the interactive operator's login.
Environment=CLOUDSDK_CONFIG=/var/lib/ciphervault-custody/gcloud
ReadWritePaths=/var/lib/ciphervault-custody
# Dispatches failure alerts to configured webhook/healthcheck/PagerDuty destination.
OnFailure=ciphervault-account-custody-failure@%n.service
