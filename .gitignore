# ==============================================================================
# Rust Build Artifacts & Intermediate Files
# ==============================================================================
target/
.cargo-targets/
.cargo/config.toml
dist/*.zip
dist/*.tar.gz
**/*.rs.bk

# Safe, reproducible release bundles are intentionally versioned. Do not
# unignore private vault state, operator runtime data, or credential archives.
!dist/repo.tar.gz
!dist/ciphervault-source-*.tar.gz
!dist/ciphervault-tui-*.zip

# ==============================================================================
# CipherVault Security Invariants: Local Vaults, Keys & Credentials
# ==============================================================================
# Local encrypted SQLite vault database and device identity keys
.ciphervault/
secrets/
secrets.env
*.env
.env*
!deploy/docker/.env.example
!deploy/gcp/.env.example

# Cryptographic private keys, certificates, and identity files
*.key
*.pem
*.pfx
*.p12
*.crt
*.cer
*.der
*.private

# Cloud credentials, tokens, and service accounts
*credentials*.json
*service-account*.json
google-creds*.json
client_secret*.json

# Disaster recovery paper kits and threshold guardian shares
*recovery*.txt
*recovery_kit*.txt
emergency_recovery*.txt
guardian_sheets/
*guardian*.txt
*share*.txt
threshold_shares/

# Databases, SQLite storage, and WAL journals
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Operator runtime state & replicated chunks
data/
operator-data*/

# Diagnostics, logs & review evidence
*.log
readiness-*.log
docs/review-evidence/

# Coverage artifacts
coverage/
lcov.info
tarpaulin-report*.html
cobertura.xml

