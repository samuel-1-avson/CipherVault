# ==============================================================================
# Rust Build Artifacts & Intermediate Files
# ==============================================================================
target/
.cargo-targets/
.cargo/config.toml
dist/*.zip
dist/*.tar.gz
dist/bin/*.exe
**/*.rs.bk

# Safe, reproducible release bundles are intentionally versioned. Do not
# unignore private vault state, operator runtime data, or credential archives.
!dist/repo.tar.gz
!dist/ciphervault-source-*.tar.gz
!dist/ciphervault-tui-*.zip

# ==============================================================================
# CipherVault Security Invariants: Local Vaults, Keys & Credentials
# ==============================================================================
# Local encrypted SQLite vault database and device identity keys
.ciphervault/
secrets/
secrets.env
*.env
.env*
!deploy/docker/.env.example
!deploy/gcp/.env.example

# Cryptographic private keys, certificates, and identity files
*.key
*.pem
*.pfx
*.p12
*.crt
*.cer
*.der
*.private

# Cloud credentials, tokens, and service accounts
*credentials*.json
*service-account*.json
google-creds*.json
client_secret*.json

# Disaster recovery paper kits and threshold guardian shares
*recovery*.txt
*recovery_kit*.txt
emergency_recovery*.txt
guardian_sheets/
*guardian*.txt
*share*.txt
threshold_shares/

# Databases, SQLite storage, and WAL journals
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Operator runtime state & replicated chunks
data/
operator-data*/

# Diagnostics, logs & review evidence
*.log
readiness-*.log
docs/review-evidence/

# ==============================================================================
# Internal working docs (kept locally, not published)
# ==============================================================================
# Dated audits, ratings, status/progress reports, plans, drafts and rollout logs
# are working notes, not documentation. The published docs live in docs/, docs/adr/
# and the READMEs. report/ publishes only the curated evidence set allow-listed
# below (cited by docs, code comments or tooling). To publish another report,
# add an explicit "!/report/<name>" line and link it from report/README.md.
/PROJECT_AUDIT_AND_ANALYSIS_REPORT.md
/report/*
!/report/README.md
!/report/DEPLOYMENT_2026-09-30.md
