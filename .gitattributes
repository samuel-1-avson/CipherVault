# Set default behavior to automatically normalize line endings
* text=auto

# Ensure shell scripts always have Unix LF line endings
*.sh text eol=lf
*.bash text eol=lf
Dockerfile* text eol=lf
Caddyfile* text eol=lf

# Rust sources are LF-only; kills CRLF drift between Windows/Unix checkouts
*.rs text eol=lf
