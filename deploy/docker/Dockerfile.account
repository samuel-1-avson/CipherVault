# ======================================================================
# CipherVault hosted account/control-plane service
# ======================================================================
FROM rust:1-slim-bookworm@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS builder

WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY apps ./apps
RUN cargo build --release --locked --bin ciphervault-account

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 10001 ciphervault && \
    useradd -u 10001 -g ciphervault -s /usr/sbin/nologin -m ciphervault && \
    mkdir -p /var/lib/ciphervault-account && \
    chown -R ciphervault:ciphervault /var/lib/ciphervault-account

COPY --from=builder /workspace/target/release/ciphervault-account /usr/local/bin/ciphervault-account
USER ciphervault
WORKDIR /var/lib/ciphervault-account
EXPOSE 8300
ENV CIPHERVAULT_ACCOUNT_BIND=0.0.0.0:8300 \
    CIPHERVAULT_ACCOUNT_DATA_DIR=/var/lib/ciphervault-account
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:8300/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/ciphervault-account"]
