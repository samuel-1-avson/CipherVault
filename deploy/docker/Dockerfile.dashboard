# ==============================================================================
# Build Stage
# ==============================================================================
FROM rust:1-slim-bookworm@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS builder

WORKDIR /workspace

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace source files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY apps ./apps

# Build production CLI binary (which includes embedded UI assets)
RUN cargo build --release --locked --bin ciphervault

# ==============================================================================
# Runtime Stage
# ==============================================================================
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime

RUN apt-get update && apt-get upgrade -y --no-install-recommends && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for principle of least privilege
RUN groupadd -g 10001 ciphervault && \
    useradd -u 10001 -g ciphervault -s /bin/bash -m ciphervault

# Prepare persistent data directory
RUN mkdir -p /var/lib/ciphervault-ui && \
    chown -R ciphervault:ciphervault /var/lib/ciphervault-ui

COPY --from=builder /workspace/target/release/ciphervault /usr/local/bin/ciphervault
COPY deploy/docker/entrypoint-dashboard.sh /usr/local/bin/entrypoint-dashboard.sh
COPY deploy/docker/entrypoint-public-feed-publisher.sh /usr/local/bin/entrypoint-public-feed-publisher.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint-dashboard.sh && \
    sed -i 's/\r$//' /usr/local/bin/entrypoint-public-feed-publisher.sh && \
    chmod +x /usr/local/bin/entrypoint-dashboard.sh /usr/local/bin/entrypoint-public-feed-publisher.sh

USER ciphervault
WORKDIR /var/lib/ciphervault-ui

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:8080/api/vault || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint-dashboard.sh"]
