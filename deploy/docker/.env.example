# Non-secret production Compose template.
# The file named by CIPHERVAULT_ACCOUNT_TOTP_KEY_FILE must be supplied by the
# deployment secret mount and must never be committed.
CIPHERVAULT_ACCOUNT_TOTP_KEY_FILE=/run/ciphervault-account-totp-key
CIPHERVAULT_ACCOUNT_REQUIRE_TOTP_KEY=true
CIPHERVAULT_ACCOUNT_SCOPE_TOKEN_KEY_FILE=/run/ciphervault-account/scope-token-key
CIPHERVAULT_ACCOUNT_LOCAL_KEK_FILE=/run/ciphervault-account/local-kek
CIPHERVAULT_VCS_WEBHOOK_KEY_FILE=/run/ciphervault-account/vcs-webhook-key
