# ==============================================================================
# Build Stage
# ==============================================================================
FROM rust:1-slim-bookworm@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS builder


WORKDIR /workspace

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace source files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY apps ./apps

# Build commit SHA is baked into /v1/info (build_sha) so fleets can detect
# version drift. Pass --build-arg GIT_SHA=$(git rev-parse --short HEAD).
ARG GIT_SHA=unknown
# Build production operator binary
RUN CIPHERVAULT_BUILD_SHA=${GIT_SHA} cargo build --release --locked --bin ciphervault-operator

# ==============================================================================
# Runtime Stage
# ==============================================================================
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime

RUN apt-get update && apt-get upgrade -y --no-install-recommends && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for principle of least privilege
RUN groupadd -g 10001 ciphervault && \
    useradd -u 10001 -g ciphervault -s /bin/false -m ciphervault

# Prepare persistent data directory
RUN mkdir -p /var/lib/ciphervault && \
    chown -R ciphervault:ciphervault /var/lib/ciphervault

COPY --from=builder /workspace/target/release/ciphervault-operator /usr/local/bin/ciphervault-operator

USER ciphervault
WORKDIR /var/lib/ciphervault

EXPOSE 8201

ENTRYPOINT ["ciphervault-operator"]
CMD ["--port", "8201", "--bind-address", "0.0.0.0", "--data-dir", "/var/lib/ciphervault", "--operator-id", "operator-1"]
