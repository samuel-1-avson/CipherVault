# ==============================================================================
# Build Stage
# ==============================================================================
FROM rust:1-slim-bookworm@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS builder


WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY apps ./apps

RUN cargo build --release --locked --bin ciphervault-maintenance

# ==============================================================================
# Runtime Stage
# ==============================================================================
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime

RUN apt-get update && apt-get upgrade -y --no-install-recommends && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 ciphervault && \
    useradd -u 10001 -g ciphervault -s /bin/false -m ciphervault

# Prepare persistent data directory with non-root ownership
RUN mkdir -p /var/lib/ciphervault && \
    chown -R ciphervault:ciphervault /var/lib/ciphervault

COPY --from=builder /workspace/target/release/ciphervault-maintenance /usr/local/bin/ciphervault-maintenance

USER ciphervault
WORKDIR /var/lib/ciphervault

ENTRYPOINT ["ciphervault-maintenance"]
CMD ["--operators", "http://operator-1:8201", "http://operator-2:8202", "http://operator-3:8203", "--interval-secs", "30"]
