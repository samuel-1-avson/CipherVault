# ==============================================================================
# CipherVault Production Caddy Ingress Configuration
# ==============================================================================
# Enterprise-grade reverse proxy with automatic ACME TLS (Let's Encrypt / ZeroSSL),
# strict security headers, body size enforcement, and connection pooling.

{
    admin off
    email {$ACME_EMAIL:admin@example.com}
    servers {
        max_header_size 64KB
        timeouts {
            read_body 30s
            read_header 10s
            write 60s
            idle 120s
        }
    }
}

# Reusable Security & Proxy Snippet
(operator_security) {
    tls {$TLS_MODE:internal}

    # Strict HTTP Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Server "CipherVault-Gateway"
        -Server
    }

    # Restrict Maximum Request Body (4 MiB object payload + protocol envelope)
    request_body {
        max_size 5MB
    }
}

# Operator 1 Public Ingress
{$OPERATOR_DOMAIN_1:op1.ciphervault.internal} {
    import operator_security

    reverse_proxy {$OPERATOR_UPSTREAM_1:operator-1:8201} {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        transport http {
            keepalive 30s
            keepalive_idle_conns 100
            response_header_timeout 30s
        }
    }
}

