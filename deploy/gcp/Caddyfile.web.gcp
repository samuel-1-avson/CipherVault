{
    admin off
    email {$ACME_EMAIL:admin@example.com}
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

{$WEB_DOMAIN:vault.example.com} {
    import security_headers
    encode zstd gzip

    # Client storage traffic enters through an operator-specific path and is
    # forwarded over the dashboard VM's private VPC routes. The operator still
    # enforces its signed challenge/session and vault-scope authorization; this
    # gateway only removes the public path prefix.
    handle_path /op/1/* {
        reverse_proxy {$OPERATOR_GATEWAY_UPSTREAM_1:10.128.0.39:80} {
            header_up X-Forwarded-Proto {scheme}
            transport http {
                keepalive 60s
            }
        }
    }

    handle_path /op/2/* {
        reverse_proxy {$OPERATOR_GATEWAY_UPSTREAM_2:10.128.0.40:80} {
            header_up X-Forwarded-Proto {scheme}
            transport http {
                keepalive 60s
            }
        }
    }

    handle_path /op/3/* {
        reverse_proxy {$OPERATOR_GATEWAY_UPSTREAM_3:10.142.0.2:80} {
            header_up X-Forwarded-Proto {scheme}
            transport http {
                keepalive 60s
            }
        }
    }

    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}

        # Crucial: disable response buffering for real-time SSE telemetry
        flush_interval -1

        transport http {
            keepalive 60s
        }
    }
}
